# Buildroot defconfig for QMTECH Cyclone V SoC with odo-miner
#
# Usage:
#   cd buildroot-2025.11.3
#   cp ../odo-miner-cyclonev/linux/buildroot_cyclonev_defconfig configs/cyclonev_defconfig
#   make cyclonev_defconfig
#   make
#
# Build time: ~60 minutes on a modern machine with good internet

# CPU Architecture
BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_ARM_EABI=y
BR2_ARM_INSTRUCTIONS_THUMB2=y
BR2_OPTIMIZE_FOR_BUILD=y

# C Library (glibc supports newer kernel headers)
BR2_LIBC_GLIBC=y

# Linux Kernel (5.15 LTS with FPGA Manager support, supported until Oct 2026)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="5.15.170"
BR2_LINUX_KERNEL_DEFCONFIG="multi_v7"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="socfpga_cyclone5"
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="zImage"

# FPGA Manager (runtime bitstream loading)
BR2_LINUX_KERNEL_EXT_SOCFPGA=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_SOCFPGA=y

# U-Boot bootloader (QMTECH Cyclone V)
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2023.10"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="socfpga_cyclone5"
BR2_UBOOT_SPL=y

# Root filesystem (ext4, 256MB)
BR2_TARGET_ROOTFS_EXT4=y
BR2_TARGET_ROOTFS_EXT4_SIZE="256M"

# Busybox (essential utilities)
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# System utilities
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_E2FSPROGS=y

# Networking (Ethernet)
BR2_PACKAGE_DHCP=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_NET_TOOLS=y

# Development tools (for troubleshooting)
BR2_PACKAGE_MAKE=y
BR2_PACKAGE_GIT=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_LSOF=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_IPERF=y

# Performance monitoring
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_PSMISC=y

# System time sync
BR2_PACKAGE_NTP=y
BR2_PACKAGE_NTPD=y

# Locale
BR2_GENERATE_LOCALE="en_US"
BR2_SYSTEM_LOCALE="en_US.UTF-8"
BR2_SYSTEM_DEFAULT_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Hostname and root password
BR2_SYSTEM_HOSTNAME="odo-miner"
BR2_TARGET_GENERIC_ROOT_PASSWD="odo-miner"

# Login banner
BR2_TARGET_GENERIC_ISSUE="Welcome to odo-miner (Cyclone V SoC)"

# Device table
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_UDEV=y

# Security: disable root login via SSH (optional, keep enabled for initial testing)
# BR2_PACKAGE_OPENSSH_DISABLE_ROOT_LOGIN=y

# Serial console
BR2_PACKAGE_GETTY_AGETTY=y
BR2_PACKAGE_GETTY_AGETTY_BAUDRATE=115200

# USB WiFi Support (for USB adapters like Realtek RTL8188, TP-Link, etc.)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTLWIFI=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_OPENSSL=y
BR2_PACKAGE_WPA_CLI=y

# Optional: AP mode support (if board acts as WiFi hotspot)
# BR2_PACKAGE_HOSTAPD=y

# Optional: Additional WiFi drivers for other adapters
# BR2_PACKAGE_LINUX_FIRMWARE_RALINK=y
# BR2_PACKAGE_LINUX_FIRMWARE_BNXFMAC=y

# Optional: MQTT / remote monitoring
# BR2_PACKAGE_MOSQUITTO=y
# BR2_PACKAGE_MOSQUITTO_CLIENTS=y

# Build optimizations
BR2_JLEVEL=8
BR2_CCACHE=y
BR2_CCACHE_USE_ENVVAR=y

# Use system CMake (skip building broken host-cmake with DAP)
BR2_CMAKE=y
