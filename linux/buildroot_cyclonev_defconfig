# QMTECH Cyclone V SoC - odo-miner Buildroot defconfig (Buildroot 2025.11.x)
#
# Toolchain: Bootlin external armv7-eabihf "stable" = gcc 14.3 + glibc 2.41
# (internal Buildroot toolchain would build glibc 2.42, which is buggy;
# external toolchain is also prebuilt, saving ~1h of build time)

# -----------------------------------------------------------------------------
# CPU Architecture
# Cortex-A9's FPU is optional in Kconfig: without ENABLE_VFP/ENABLE_NEON the
# EABIhf option is invisible and silently falls back to soft-float EABI,
# which in turn hides the Bootlin armv7-eabihf toolchain and python3.
# -----------------------------------------------------------------------------
BR2_arm=y
BR2_cortex_a9=y
BR2_USE_MMU=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_NEON=y
BR2_ARM_INSTRUCTIONS_THUMB2=y

# -----------------------------------------------------------------------------
# Toolchain (Bootlin external, glibc 2.41)
# -----------------------------------------------------------------------------
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_GLIBC_STABLE=y
BR2_SHARED_LIBS=y
# gconv charset-conversion libraries (copied from toolchain sysroot)
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY=y

# -----------------------------------------------------------------------------
# Kernel (6.6.26) — headers default to "same as kernel", no explicit config.
# Fragments: linux-wifi (Realtek USB WiFi), linux-fpga (FPGA manager/bridges),
# linux-display (fabric SPI TFT + touch + keys/LEDs). Fan/thermal needs no
# kernel fragment — driven via direct /dev/mem PIO access, see hps/thermal.c.
# -----------------------------------------------------------------------------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.26"
BR2_LINUX_KERNEL_DEFCONFIG="multi_v7"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/qmtech/cyclonev/linux-wifi.fragment board/qmtech/cyclonev/linux-fpga.fragment board/qmtech/cyclonev/linux-display.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# Primary DTB: custom QMTECH board DTS (SoCDK base + fabric peripherals).
# SoCDK DTB is kept as a known-good fallback for bring-up.
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="board/qmtech/cyclonev/socfpga_cyclone5_qmtech_odo.dts"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="intel/socfpga/socfpga_cyclone5_socdk"
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="zImage"

# -----------------------------------------------------------------------------
# Rootfs overlay: BusyBox init scripts (S90odod miner, S95odoui touch panel,
# S96odowebd web dashboard) and the /etc/odod.conf template.
# Copied from linux/overlay/ by scripts/build-buildroot.sh.
# -----------------------------------------------------------------------------
BR2_ROOTFS_OVERLAY="board/qmtech/cyclonev/overlay"

# -----------------------------------------------------------------------------
# U-Boot (Cyclone V BootROM needs the .sfp preloader image, not .bin)
# -----------------------------------------------------------------------------
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2023.10"
# DE10-Nano preloader: this QMTECH board is DE10-Nano ball-/MiSTer-compatible,
# so its HPS DDR3 is 32-bit non-ECC (NOT the SoCDK's 40-bit ECC). The SoCDK
# "socfpga_cyclone5" preloader hangs in DDR calibration before UART init
# (silent board). socfpga_de10_nano carries the matching DDR3/pinmux/PLL/IOCSR
# handoff. See scripts/diag-ddr.sh for the proof.
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="socfpga_de10_nano"
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-with-spl.sfp"
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="spl/u-boot-spl.sfp"
# Bake autoboot into U-Boot (default bootcmd runs boot.scr; 10 s countdown).
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="board/qmtech/cyclonev/uboot-autoboot.fragment"

# -----------------------------------------------------------------------------
# Root Filesystem (ext4 = EXT2 builder with the _4 generation choice;
# BR2_TARGET_ROOTFS_EXT4 does not exist)
# -----------------------------------------------------------------------------
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="8G"
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"

# -----------------------------------------------------------------------------
# BusyBox
# -----------------------------------------------------------------------------
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# -----------------------------------------------------------------------------
# System Utilities
# -----------------------------------------------------------------------------
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_E2FSPROGS=y

# -----------------------------------------------------------------------------
# Networking (dhcpcd is the DHCP client; ISC dhcp no longer exists in Buildroot)
# -----------------------------------------------------------------------------
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_NET_TOOLS=y

# -----------------------------------------------------------------------------
# Performance Monitoring
# -----------------------------------------------------------------------------
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_PSMISC=y

# -----------------------------------------------------------------------------
# Time Sync
# -----------------------------------------------------------------------------
BR2_PACKAGE_NTP=y

# -----------------------------------------------------------------------------
# Locale & System Settings
# -----------------------------------------------------------------------------
BR2_GENERATE_LOCALE="en_US"
BR2_SYSTEM_LOCALE="en_US.UTF-8"
BR2_SYSTEM_DEFAULT_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
BR2_SYSTEM_HOSTNAME="odo-miner"
BR2_TARGET_GENERIC_ROOT_PASSWD="odo-miner"
BR2_TARGET_GENERIC_ISSUE="Welcome to odo-miner (Cyclone V SoC)"

# -----------------------------------------------------------------------------
# Device Table
# -----------------------------------------------------------------------------
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_UDEV=y

# -----------------------------------------------------------------------------
# Serial Console (HPS UART0 = ttyS0)
# -----------------------------------------------------------------------------
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

# -----------------------------------------------------------------------------
# Mining Dependencies
# -----------------------------------------------------------------------------
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_JANSSON=y

# -----------------------------------------------------------------------------
# System Robustness ('watch' comes from procps-ng).
# supervisor requires python3 — without it Kconfig silently drops supervisor.
# -----------------------------------------------------------------------------
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_SUPERVISOR=y
BR2_PACKAGE_LOGROTATE=y
BR2_PACKAGE_SYSSTAT=y
BR2_PACKAGE_WATCHDOG=y

# -----------------------------------------------------------------------------
# Network Debugging
# -----------------------------------------------------------------------------
BR2_PACKAGE_IW=y
BR2_PACKAGE_TCPDUMP=y

# -----------------------------------------------------------------------------
# Memory Testing
# -----------------------------------------------------------------------------
BR2_PACKAGE_MEMTESTER=y

# -----------------------------------------------------------------------------
# Text Editing
# -----------------------------------------------------------------------------
BR2_PACKAGE_NANO=y

# -----------------------------------------------------------------------------
# WiFi Support (USB adapter: firmware here, drivers via linux-wifi.fragment)
# Realtek firmware is per-chip; trim to your dongle's chip once known.
# -----------------------------------------------------------------------------
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WEXT=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y

# -----------------------------------------------------------------------------
# Build Optimisation
# -----------------------------------------------------------------------------
BR2_JLEVEL=8
BR2_CCACHE=y
