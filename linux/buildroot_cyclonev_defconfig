# QMTECH Cyclone V SoC – odo-miner Buildroot defconfig (modernised for 2025.11.x)

# -----------------------------------------------------------------------------
# CPU Architecture
# -----------------------------------------------------------------------------
BR2_arm=y
BR2_cortex_a9=y
BR2_USE_MMU=y
BR2_ARM_EABI=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_INSTRUCTIONS_THUMB2=y
BR2_OPTIMIZE_FOR_BUILD=y

# -----------------------------------------------------------------------------
# Toolchain (modern unified libc selector)
# -----------------------------------------------------------------------------

# glibc core selection
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_LIBC="glibc"
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# glibc compatibility shims (recommended)
BR2_TOOLCHAIN_BUILDROOT_GLIBC_USE_COMPAT=y

# glibc utilities (ldconfig, getent, locale, iconv, etc.)
BR2_PACKAGE_GLIBC_UTILS=y

# glibc gconv modules (charset conversion libraries)
BR2_PACKAGE_GLIBC_UTILS_GCONV=y

# required for glibc
BR2_SHARED_LIBS=y
BR2_STATIC_LIBS=n
BR2_USE_MMU=y


# -----------------------------------------------------------------------------
# Linux Kernel (6.6 LTS)
# -----------------------------------------------------------------------------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.26"
BR2_LINUX_KERNEL_DEFCONFIG="multi_v7"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="socfpga_cyclone5"
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="zImage"

# FPGA Manager
BR2_LINUX_KERNEL_EXT_SOCFPGA=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_SOCFPGA=y

# -----------------------------------------------------------------------------
# U-Boot Bootloader
# -----------------------------------------------------------------------------
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2023.10"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="socfpga_cyclone5"
BR2_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL=y

# -----------------------------------------------------------------------------
# Root Filesystem
# -----------------------------------------------------------------------------
BR2_TARGET_ROOTFS_EXT4=y
BR2_TARGET_ROOTFS_EXT4_SIZE="8G"

# -----------------------------------------------------------------------------
# BusyBox
# -----------------------------------------------------------------------------
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# -----------------------------------------------------------------------------
# System Utilities
# -----------------------------------------------------------------------------
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_E2FSPROGS=y

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------
BR2_PACKAGE_DHCP=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_NET_TOOLS=y

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
BR2_PACKAGE_MAKE=y
BR2_PACKAGE_GIT=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_LSOF=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_IPERF=y

# -----------------------------------------------------------------------------
# Performance Monitoring
# -----------------------------------------------------------------------------
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_PSMISC=y

# -----------------------------------------------------------------------------
# Time Sync
# -----------------------------------------------------------------------------
BR2_PACKAGE_NTP=y
BR2_PACKAGE_NTPD=y

# -----------------------------------------------------------------------------
# Locale & System Settings
# -----------------------------------------------------------------------------
BR2_GENERATE_LOCALE="en_US"
BR2_SYSTEM_LOCALE="en_US.UTF-8"
BR2_SYSTEM_DEFAULT_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

BR2_SYSTEM_HOSTNAME="odo-miner"
BR2_TARGET_GENERIC_ROOT_PASSWD="odo-miner"
BR2_TARGET_GENERIC_ISSUE="Welcome to odo-miner (Cyclone V SoC)"

# -----------------------------------------------------------------------------
# Device Table
# -----------------------------------------------------------------------------
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_UDEV=y

# -----------------------------------------------------------------------------
# Serial Console
# -----------------------------------------------------------------------------
BR2_PACKAGE_GETTY_AGETTY=y
BR2_PACKAGE_GETTY_AGETTY_BAUDRATE=115200

# -----------------------------------------------------------------------------
# Build Tools (on-target)
# -----------------------------------------------------------------------------
BR2_PACKAGE_GCC=y
BR2_PACKAGE_BINUTILS=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_LINUX_HEADERS=y
BR2_PACKAGE_PKGCONF=y
BR2_PACKAGE_AUTOCONF=y
BR2_PACKAGE_AUTOMAKE=y

# -----------------------------------------------------------------------------
# Mining Dependencies
# -----------------------------------------------------------------------------
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_JANSSON=y

# -----------------------------------------------------------------------------
# System Robustness
# -----------------------------------------------------------------------------
BR2_PACKAGE_SUPERVISOR=y
BR2_PACKAGE_LOGROTATE=y
BR2_PACKAGE_SYSSTAT=y
BR2_PACKAGE_WATCH=y
BR2_PACKAGE_WATCHDOG=y

# -----------------------------------------------------------------------------
# Network Debugging
# -----------------------------------------------------------------------------
BR2_PACKAGE_IW=y
BR2_PACKAGE_TCPDUMP=y

# -----------------------------------------------------------------------------
# Memory Testing
# -----------------------------------------------------------------------------
BR2_PACKAGE_MEMTESTER=y

# -----------------------------------------------------------------------------
# Text Editing
# -----------------------------------------------------------------------------
BR2_PACKAGE_NANO=y

# -----------------------------------------------------------------------------
# WiFi Support
# -----------------------------------------------------------------------------
BR2_PACKAGE_LINUX_FIRMWARE_RTLWIFI=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_OPENSSL=y
BR2_PACKAGE_WPA_CLI=y

# -----------------------------------------------------------------------------
# Build Optimisation
# -----------------------------------------------------------------------------
BR2_JLEVEL=8
BR2_CCACHE=y
BR2_CCACHE_USE_ENVVAR=y

# -----------------------------------------------------------------------------
# Use system CMake
# -----------------------------------------------------------------------------
BR2_CMAKE=y
