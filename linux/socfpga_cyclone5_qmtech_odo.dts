// SPDX-License-Identifier: GPL-2.0
/*
 * QMTECH Cyclone V SoC KFB (dual SDRAM) — odo-miner board device tree.
 *
 * Extends the in-tree SoCDK board (closest match: same Cyclone V SX family,
 * RGMII EMAC1, 8-bit SD, UART0) with the fabric peripherals generated by
 * hdl/qsys/soc_system.qsys on the lightweight HPS-to-FPGA bridge:
 *
 *   0xFF200000  odocrypt miner registers (no kernel driver; odod uses /dev/mem)
 *   0xFF201000  SPI master, ILI9341 TFT          (IRQ f2h 0 -> GIC SPI 72)
 *   0xFF201100  SPI master, XPT2046/ADS7846 touch (IRQ f2h 1 -> GIC SPI 73)
 *   0xFF201200  PIO out: LCD D/C, RESET_n, backlight
 *   0xFF201300  PIO in : touch PENIRQ_n, KEY0, KEY1 (IRQ f2h 2 -> GIC SPI 74)
 *   0xFF201400  PIO out: board LEDs
 *
 * NOTE: the LWH2F bridge must be enabled (via U-Boot bridge_enable or the
 * fpga2hps/hps2fpga bridge driver) before any of these devices probe usefully.
 */

/* Buildroot copies this file to arch/arm/boot/dts/, so the in-tree board
 * include needs its post-6.5 vendor-directory path. */
#include "intel/socfpga/socfpga_cyclone5_socdk.dts"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "QMTECH Cyclone V SoC KFB (odo-miner)";

	vcc3v3_fab: regulator-fab-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3-fabric";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	soc {
		spi_lcd: spi@ff201000 {
			compatible = "altr,spi-1.0";
			reg = <0xff201000 0x20>;
			interrupts = <0 72 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			/* KMRTM28028-SPI: 2.8" 240x320 ILI9341 panel.
			 * rotate=270 -> 320x240 landscape (matches odo_ui.c layout). */
			display@0 {
				compatible = "ilitek,ili9341";
				reg = <0>;
				spi-max-frequency = <25000000>;
				dc-gpios    = <&pio_lcd 0 GPIO_ACTIVE_HIGH>;
				reset-gpios = <&pio_lcd 1 GPIO_ACTIVE_LOW>;
				led-gpios   = <&pio_lcd 2 GPIO_ACTIVE_HIGH>;
				rotate = <270>;
				bgr;
				fps = <30>;
				buswidth = <8>;
			};
		};

		spi_touch: spi@ff201100 {
			compatible = "altr,spi-1.0";
			reg = <0xff201100 0x20>;
			interrupts = <0 73 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			touchscreen@0 {
				compatible = "ti,ads7846";
				reg = <0>;
				spi-max-frequency = <1500000>;
				vcc-supply = <&vcc3v3_fab>;

				interrupt-parent = <&pio_in>;
				interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
				pendown-gpio = <&pio_in 0 GPIO_ACTIVE_LOW>;

				ti,x-min = /bits/ 16 <150>;
				ti,x-max = /bits/ 16 <3900>;
				ti,y-min = /bits/ 16 <150>;
				ti,y-max = /bits/ 16 <3900>;
				ti,x-plate-ohms = /bits/ 16 <60>;
				ti,pressure-max = /bits/ 16 <255>;
				ti,swap-xy;
				wakeup-source;
			};
		};

		pio_lcd: gpio@ff201200 {
			compatible = "altr,pio-1.0";
			reg = <0xff201200 0x10>;
			altr,ngpio = <3>;
			gpio-controller;
			#gpio-cells = <2>;
			status = "okay";
		};

		pio_in: gpio@ff201300 {
			compatible = "altr,pio-1.0";
			reg = <0xff201300 0x10>;
			interrupts = <0 74 IRQ_TYPE_LEVEL_HIGH>;
			altr,ngpio = <3>;
			altr,interrupt-type = <IRQ_TYPE_EDGE_FALLING>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			status = "okay";
		};

		pio_led: gpio@ff201400 {
			compatible = "altr,pio-1.0";
			reg = <0xff201400 0x10>;
			altr,ngpio = <8>;
			gpio-controller;
			#gpio-cells = <2>;
			status = "okay";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key0 {
			label = "KEY0";
			gpios = <&pio_in 1 GPIO_ACTIVE_LOW>;
			linux,code = <103>;	/* KEY_UP */
		};

		key1 {
			label = "KEY1";
			gpios = <&pio_in 2 GPIO_ACTIVE_LOW>;
			linux,code = <108>;	/* KEY_DOWN */
		};
	};

	leds {
		compatible = "gpio-leds";

		led0 { label = "odo:green:status";  gpios = <&pio_led 0 GPIO_ACTIVE_HIGH>; linux,default-trigger = "heartbeat"; };
		led1 { label = "odo:green:mining";  gpios = <&pio_led 1 GPIO_ACTIVE_HIGH>; };
		led2 { label = "odo:green:share";   gpios = <&pio_led 2 GPIO_ACTIVE_HIGH>; };
		led3 { label = "odo:green:net";     gpios = <&pio_led 3 GPIO_ACTIVE_HIGH>; };
		led4 { label = "odo:green:user4";   gpios = <&pio_led 4 GPIO_ACTIVE_HIGH>; };
		led5 { label = "odo:green:user5";   gpios = <&pio_led 5 GPIO_ACTIVE_HIGH>; };
		led6 { label = "odo:green:user6";   gpios = <&pio_led 6 GPIO_ACTIVE_HIGH>; };
		led7 { label = "odo:green:user7";   gpios = <&pio_led 7 GPIO_ACTIVE_HIGH>; };
	};
};
