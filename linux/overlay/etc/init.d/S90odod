#!/bin/sh
# S90odod — start the OdoCrypt FPGA miner daemon (BusyBox init).
#
# Configuration: /etc/odod.conf (shell syntax), e.g.
#   ODOD_POOL_HOST=pool.example.com
#   ODOD_POOL_PORT=3333
#   ODOD_WORKER=DGB1yourpayoutaddress.worker1
#   ODOD_PASSWORD=x
#   ODO_TESTNET=0
#
# The FPGA bitstream and bridges are set up by U-Boot (boot.scr) before
# Linux starts, so the miner can talk to 0xFF200000 immediately.

DAEMON=/usr/bin/odo-miner
DAEMON_PIPE=/usr/bin/odo-miner-pipe
CONF=/etc/odod.conf
# /var/run does not exist on this minimal rootfs; /run is the tmpfs.
PIDFILE=/run/odod.pid

[ -f "$CONF" ] && . "$CONF"

# Auto-detect which FPGA core is loaded by reading the version register at the
# LW HPS->FPGA bridge (0xFF200008): 0x0001_xxxx = sequential FSM core,
# 0x0002_xxxx = pipelined core. Pick the matching daemon so the same SD card
# works with either bitstream. Falls back to the FSM daemon if devmem fails.
# For the pipelined core, prefer the UIO interrupt-driven backend when
# /dev/uio0 is present; fall back to the /dev/mem polling backend otherwise.
pick_daemon() {
    DAEMON_SEL="$DAEMON"
    if [ -x /sbin/devmem ] || command -v devmem >/dev/null 2>&1; then
        ver=$(devmem 0xFF200008 32 2>/dev/null)
        case "$ver" in
            0x0002*)
                if [ -c /dev/uio0 ] && [ -x /usr/bin/odo-miner-pipe-uio ]; then
                    DAEMON_SEL="/usr/bin/odo-miner-pipe-uio"
                elif [ -x "$DAEMON_PIPE" ]; then
                    DAEMON_SEL="$DAEMON_PIPE"
                fi
                ;;
        esac
    fi
}

start() {
    printf "Starting odo-miner: "
    mkdir -p /run/odod /var/lib/odod
    pick_daemon
    if [ ! -x "$DAEMON_SEL" ]; then
        echo "MISSING ($DAEMON_SEL)"
        return 1
    fi
    [ -e /dev/fb0 ] && /usr/bin/odo-ui splash "Starting miner..." 2>/dev/null
    export ODO_TESTNET ODO_EPOCH_INTERVAL ODOMIN_NONCE_RANGE ODOMIN_POLL_TIMEOUT_MS ODOD_WATCHDOG ODOD_POOL_HOST2 ODOD_POOL_PORT2
    start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON_SEL" -- \
        "${ODOD_POOL_HOST:-127.0.0.1}" "${ODOD_POOL_PORT:-3333}" \
        "${ODOD_WORKER:-miner}" "${ODOD_PASSWORD:-x}"
    echo "OK (${DAEMON_SEL##*/})"
}

stop() {
    printf "Stopping odo-miner: "
    start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
    rm -f "$PIDFILE"
    echo "OK"
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
