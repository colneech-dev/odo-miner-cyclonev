#!/bin/sh
# S91epochcron — run epoch-update.sh on a 5-minute loop.
#
# NOTE: despite the filename, this is NOT crond-based anymore. It was
# originally a crontab installer, but crond was observed (2026-07-19) to
# silently exit within ~30s of boot with zero trace in dmesg or syslog — no
# OOM kill, no segfault, nothing — leaving the crontab entry correctly
# installed but never executed. The board mined on a stale epoch bitstream
# for 9+ days (~97.6% share rejection) before this was caught manually; the
# staged /boot/fpga_next.rbf sat untouched the whole time. Nothing else on
# this board uses cron, so removing the crond dependency for something this
# safety-critical outweighs keeping the filename accurate — a plain shell
# loop has far less surface area to fail the same silent way. Filename kept
# so deploy tooling / docs referencing "S91epochcron" still find it.
#
# epoch-update.sh compares status.json's "epoch" (the pool's current job
# epoch) against "bitstream_epoch" (what's baked into the running FPGA); when
# they diverge it swaps in a staged /boot/fpga_next.rbf and reboots (see
# usr/sbin/epoch-update.sh and docs/pipelined-miner-scope.md WS3 v1). It does
# NOT use a wall-clock epoch_next predictor — block time lags wall-clock on a
# sparse chain, so the direct epoch!=bitstream_epoch compare is the reliable
# trigger. The staged file is placed there by the build host ahead of time
# (scripts/epoch_build_deploy.ps1) — this just applies it at the right moment.

PIDFILE=/run/epochloop.pid
INTERVAL=300   # 5 minutes, matching the old cron cadence

start() {
    printf "Starting epoch-update loop: "
    (
        while true; do
            /usr/sbin/epoch-update.sh >>/var/log/epoch-update.log 2>&1
            sleep "$INTERVAL"
        done
    ) </dev/null >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
    echo "OK"
}

stop() {
    printf "Stopping epoch-update loop: "
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    echo "OK"
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
