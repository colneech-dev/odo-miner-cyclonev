#!/bin/sh
# S04odosplash — paint a boot splash on the TFT as early as possible, so the
# screen shows "Booting..." during the rest of init instead of a stale frame.
# The per-stage scripts (S45wifi, S90odod) update the message as they run.

[ "$1" = start ] || exit 0

# The fbtft framebuffer may appear a moment after init starts; wait briefly.
n=0
while [ ! -e /dev/fb0 ] && [ $n -lt 6 ]; do
    sleep 1
    n=$((n + 1))
done
[ -e /dev/fb0 ] || exit 0

/usr/bin/odo-ui splash "Booting odo-miner..." 2>/dev/null
