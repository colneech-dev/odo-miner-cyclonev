#!/bin/sh
# S50sshd — OpenSSH server for remote board management (key-based root login).
#
# Enables network deploys/debugging so changes no longer require an SD-card
# cycle. Host keys are generated on first boot and persist on the ext4 rootfs.
# Authorized key: /root/.ssh/authorized_keys (tools/testnet/odo-miner in the repo).

SSHD=/usr/sbin/sshd

[ -x "$SSHD" ] || { echo "sshd: $SSHD not present in rootfs"; exit 0; }

start() {
    printf "Starting sshd: "
    # Generate only ed25519 host key (RSA requires much more entropy and can
    # block for minutes on /dev/random at early boot when the pool is thin).
    [ -f /etc/ssh/ssh_host_ed25519_key ] || \
        ssh-keygen -q -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" || \
        { echo "FAIL (ssh-keygen)"; return 1; }
    mkdir -p /run/sshd /var/empty
    # sshd refuses keys unless the key files have tight ownership/permissions.
    if [ -d /root/.ssh ]; then
        chown -R root:root /root /root/.ssh
        chmod 700 /root /root/.ssh
        [ -f /root/.ssh/authorized_keys ] && chmod 600 /root/.ssh/authorized_keys
    fi
    if "$SSHD"; then echo "OK"; else echo "FAIL"; fi
}

stop() {
    printf "Stopping sshd: "
    killall sshd 2>/dev/null
    echo "OK"
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
