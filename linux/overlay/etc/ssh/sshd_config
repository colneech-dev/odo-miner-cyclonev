# sshd_config — remote management of the odo-miner board.
# Key-based root login only (key: tools/testnet/odo-miner). LAN/testnet use.
Port 22
HostKey /etc/ssh/ssh_host_ed25519_key
PermitRootLogin prohibit-password
PubkeyAuthentication yes
PasswordAuthentication no
PermitEmptyPasswords no
AuthorizedKeysFile .ssh/authorized_keys
ChallengeResponseAuthentication no
# No UsePAM directive: this OpenSSH build has no PAM support at all, so the
# keyword itself (not just "yes") is unrecognized — "UsePAM no" still logs
# "Unsupported option UsePAM" at every boot even though it's harmless.
Subsystem sftp internal-sftp
