# hps/Makefile.local - additional local targets for building new HPS tools
# This file is intentionally non-destructive: it does not overwrite the repo's
# existing hps/Makefile. To build with these targets run:
#   make -f hps.Makefile.local miner_with_watcher

CC := gcc
CFLAGS := -O2 -Wall -pthread
LDFLAGS :=

# Sources for the miner_with_watcher integration example
MINER_WATCHER_SRCS := hps.miner_with_watcher.c hps.minor_io.c hps_epoch_watcher.c
# Existing test program (already present)
MINER_IO_TEST_SRCS := hps.minor_io_test.c hps.minor_io.c

.PHONY: all miner_with_watcher miner_io_test clean-local
all: miner_with_watcher miner_io_test

miner_with_watcher: $(MINER_WATCHER_SRCS)
	$(CC) $(CFLAGS) -o $@ $(MINER_WATCHER_SRCS) $(LDFLAGS)

miner_io_test: $(MINER_IO_TEST_SRCS)
	$(CC) $(CFLAGS) -o $@ $(MINER_IO_TEST_SRCS) $(LDFLAGS)

clean-local:
	rm -f miner_with_watcher miner_io_test

# End of hps.Makefile.local
