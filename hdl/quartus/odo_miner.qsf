# =============================================================================
# Quartus Settings File — OdoCrypt Miner for QMTECH Cyclone V SoC
# Device: 5CSXFC6C6U23 (Cyclone V SX, 110K LE, 204 M10K, 112 DSP, 484-ball BGA)
# Board:  QMTECH Cyclone V SoC KFB
# =============================================================================

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6C6U23
set_global_assignment -name TOP_LEVEL_ENTITY soc_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# --- Compilation mode ---------------------------------------------------------
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name GENERATE_RBF_FILE ON

# --- Timing constraints -------------------------------------------------------
set_global_assignment -name SDC_FILE ../constraints/miner.sdc

# --- RTL source files ---------------------------------------------------------

# Top-level SoC wrapper
set_global_assignment -name VERILOG_FILE ../src/soc_top.v

# Miner Avalon-MM slave
set_global_assignment -name VERILOG_FILE ../src/odocrypt_top.v

# OdoCrypt core
set_global_assignment -name VERILOG_FILE ../src/odocrypt/odocrypt_core.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/odocrypt_compress.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/odocrypt_round.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/odocrypt_epoch_mutator.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/odocrypt_sbox_dsp.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/odocrypt_array.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/difficulty_compare.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/perf_counter.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/nonce_scheduler.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/hash_pll.v

# Keccak-800 post-hash
set_global_assignment -name VERILOG_FILE ../src/keccak/keccak800.v

# Clock-domain crossing
set_global_assignment -name VERILOG_FILE ../src/cdc/cdc_sync.v
set_global_assignment -name VERILOG_FILE ../src/cdc/cdc_found.v
set_global_assignment -name VERILOG_FILE ../src/cdc/cdc_bus.v

# Qsys-generated system (generated by Platform Designer; not in repo until first build)
# set_global_assignment -name QSYS_FILE ../qsys/soc_system.qsys
# set_global_assignment -name VERILOG_FILE ../qsys/soc_system/synthesis/soc_system.v

# --- HPS/Qsys EDA paths (Quartus needs these for SoC projects) ----------------
set_global_assignment -name HPS_EARLY_IO_RELEASE ON

# --- Synthesis settings -------------------------------------------------------
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name ALLOW_REGISTER_RETIMING ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF

# --- Pin assignments ----------------------------------------------------------
# IMPORTANT: These must be verified against the QMTECH 5CSXFC6C6U23 board
# schematic and the QMTECH GHRD before synthesis.
# Cross-reference against: https://github.com/ChinaQMTECH/QMTECH_CycloneV_SoC

# 50 MHz board oscillator → FPGA fabric clock
# Verify pin against QMTECH schematic (commonly V11 on this board).
set_location_assignment PIN_V11 -to CLOCK_50

# Active-low reset (board KEY0 or HPS reset)
set_location_assignment PIN_AH17 -to RESET_n

# HPS DDR3 — driven by the HPS hard memory controller; pin locations are
# fixed by the HPS I/O bank and are defined in the Platform Designer HPS
# component (bsp-editor). Do NOT assign these manually — let Platform Designer
# generate the pin-mux and constraint files from the GHRD handoff.
# They are listed here for reference only.
#
# HPS_DDR3_ADDR[14:0], HPS_DDR3_BA[2:0], HPS_DDR3_CAS_n,
# HPS_DDR3_CKE, HPS_DDR3_CK_n, HPS_DDR3_CK_p,
# HPS_DDR3_CS_n, HPS_DDR3_DM[3:0], HPS_DDR3_DQ[31:0],
# HPS_DDR3_DQS_n[3:0], HPS_DDR3_DQS_p[3:0],
# HPS_DDR3_ODT, HPS_DDR3_RAS_n, HPS_DDR3_RESET_n, HPS_DDR3_WE_n

# HPS Ethernet RGMII (Marvell/Microchip PHY)
# Pins routed through HPS I/O bank — assigned by Platform Designer.
# HPS_ENET_GTX_CLK, HPS_ENET_INT_n, HPS_ENET_MDC, HPS_ENET_MDIO,
# HPS_ENET_RX_CLK, HPS_ENET_RX_DATA[3:0], HPS_ENET_RX_DV,
# HPS_ENET_TX_DATA[3:0], HPS_ENET_TX_EN, HPS_ENET_TX_ER

# HPS SD card
# HPS_SD_CLK, HPS_SD_CMD, HPS_SD_DATA[3:0]

# HPS UART
# HPS_UART_RX, HPS_UART_TX

# HPS USB OTG
# HPS_USB_CLKOUT, HPS_USB_DATA[7:0], HPS_USB_DIR, HPS_USB_NXT, HPS_USB_STP
