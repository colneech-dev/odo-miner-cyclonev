# =============================================================================
# Quartus Settings File — OdoCrypt Miner for QMTECH Cyclone V SoC
# Device: 5CSXFC6C6U23 (Cyclone V SX, 110K LE, 204 M10K, 112 DSP, 484-ball BGA)
# Board:  QMTECH Cyclone V SoC KFB
# =============================================================================

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6C6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY soc_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name IP_SEARCH_PATHS "\{hdl/qsys\}"

# --- Compilation mode ---------------------------------------------------------
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8

# --- Timing constraints -------------------------------------------------------

# --- RTL source files ---------------------------------------------------------

# Top-level SoC wrapper

# Miner Avalon-MM slave

# OdoCrypt core
# odocrypt_compress.v, odocrypt_round.v, odocrypt_sbox_dsp.v are superseded by
# the sequential odocrypt_core.v and archived in hdl/src/odocrypt/archive/

# Keccak-800 post-hash

# Clock-domain crossing

# Qsys-generated system (generated by Platform Designer; not in repo until first build)
set_global_assignment -name QSYS_FILE ../qsys/soc_system.qsys
set_global_assignment -name VERILOG_FILE ../qsys/soc_system/synthesis/soc_system.v

# --- HPS/Qsys EDA paths (Quartus needs these for SoC projects) ----------------
set_global_assignment -name HPS_EARLY_IO_RELEASE ON

# --- Synthesis settings -------------------------------------------------------
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name ALLOW_REGISTER_RETIMING ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF

# --- Pin assignments ----------------------------------------------------------
# Extracted from QMTECH Cyclone V SoC KFB Schematic v01 (32-bit DDR3)

# 50 MHz board oscillator
set_location_assignment PIN_V11 -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50

# Active-low board reset
set_location_assignment PIN_AE25 -to RESET_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to RESET_n

# HPS DDR3 (32-bit: 2 x MT41K256M16TW)
# Address [14:0]
set_location_assignment PIN_C28 -to HPS_DDR3_ADDR[0]
set_location_assignment PIN_B28 -to HPS_DDR3_ADDR[1]
set_location_assignment PIN_E26 -to HPS_DDR3_ADDR[2]
set_location_assignment PIN_D26 -to HPS_DDR3_ADDR[3]
set_location_assignment PIN_J20 -to HPS_DDR3_ADDR[4]
set_location_assignment PIN_C26 -to HPS_DDR3_ADDR[5]
set_location_assignment PIN_B26 -to HPS_DDR3_ADDR[6]
set_location_assignment PIN_F26 -to HPS_DDR3_ADDR[7]
set_location_assignment PIN_F25 -to HPS_DDR3_ADDR[8]
set_location_assignment PIN_A24 -to HPS_DDR3_ADDR[9]
set_location_assignment PIN_B24 -to HPS_DDR3_ADDR[10]
set_location_assignment PIN_D24 -to HPS_DDR3_ADDR[11]
set_location_assignment PIN_C24 -to HPS_DDR3_ADDR[12]
set_location_assignment PIN_G23 -to HPS_DDR3_ADDR[13]
set_location_assignment PIN_F24 -to HPS_DDR3_ADDR[14]
# Bank [2:0]
set_location_assignment PIN_H25 -to HPS_DDR3_BA[0]
set_location_assignment PIN_G25 -to HPS_DDR3_BA[1]
set_location_assignment PIN_A25 -to HPS_DDR3_BA[2]
# Control
set_location_assignment PIN_A26 -to HPS_DDR3_RAS_n
set_location_assignment PIN_E25 -to HPS_DDR3_CAS_n
set_location_assignment PIN_L28 -to HPS_DDR3_WE_n
set_location_assignment PIN_A27 -to HPS_DDR3_CKE[0]
set_location_assignment PIN_K28 -to HPS_DDR3_CKE[1]
set_location_assignment PIN_N2 -to HPS_DDR3_CS_n[0]
set_location_assignment PIN_D28 -to HPS_DDR3_CS_n[1]
# Clock
set_location_assignment PIN_N3 -to HPS_DDR3_CK_p
set_location_assignment PIN_N20 -to HPS_DDR3_CK_n
# Data [31:0]
set_location_assignment PIN_J25 -to HPS_DDR3_DQ[0]
set_location_assignment PIN_J24 -to HPS_DDR3_DQ[1]
set_location_assignment PIN_E28 -to HPS_DDR3_DQ[2]
set_location_assignment PIN_D27 -to HPS_DDR3_DQ[3]
set_location_assignment PIN_J26 -to HPS_DDR3_DQ[4]
set_location_assignment PIN_K26 -to HPS_DDR3_DQ[5]
set_location_assignment PIN_G27 -to HPS_DDR3_DQ[6]
set_location_assignment PIN_F28 -to HPS_DDR3_DQ[7]
set_location_assignment PIN_K25 -to HPS_DDR3_DQ[8]
set_location_assignment PIN_L25 -to HPS_DDR3_DQ[9]
set_location_assignment PIN_J27 -to HPS_DDR3_DQ[10]
set_location_assignment PIN_J28 -to HPS_DDR3_DQ[11]
set_location_assignment PIN_M27 -to HPS_DDR3_DQ[12]
set_location_assignment PIN_M26 -to HPS_DDR3_DQ[13]
set_location_assignment PIN_M28 -to HPS_DDR3_DQ[14]
set_location_assignment PIN_N28 -to HPS_DDR3_DQ[15]
set_location_assignment PIN_N25 -to HPS_DDR3_DQ[16]
set_location_assignment PIN_U25 -to HPS_DDR3_DQ[17]
set_location_assignment PIN_AA28 -to HPS_DDR3_DQ[18]
set_location_assignment PIN_W26 -to HPS_DDR3_DQ[19]
set_location_assignment PIN_AA27 -to HPS_DDR3_DQ[20]
set_location_assignment PIN_W25 -to HPS_DDR3_DQ[21]
set_location_assignment PIN_V28 -to HPS_DDR3_DQ[22]
set_location_assignment PIN_AB27 -to HPS_DDR3_DQ[23]
set_location_assignment PIN_R25 -to HPS_DDR3_DQ[24]
set_location_assignment PIN_R27 -to HPS_DDR3_DQ[25]
set_location_assignment PIN_R24 -to HPS_DDR3_DQ[26]
set_location_assignment PIN_T24 -to HPS_DDR3_DQ[27]
set_location_assignment PIN_V27 -to HPS_DDR3_DQ[28]
set_location_assignment PIN_Y27 -to HPS_DDR3_DQ[29]
set_location_assignment PIN_W27 -to HPS_DDR3_DQ[30]
set_location_assignment PIN_AE27 -to HPS_DDR3_DQ[31]
# DQS [1:0]
set_location_assignment PIN_R17 -to HPS_DDR3_DQS_p[0]
set_location_assignment PIN_R16 -to HPS_DDR3_DQS_n[0]
set_location_assignment PIN_R19 -to HPS_DDR3_DQS_p[1]
set_location_assignment PIN_R18 -to HPS_DDR3_DQS_n[1]
# DM [3:0]
set_location_assignment PIN_G28 -to HPS_DDR3_DM[0]
set_location_assignment PIN_P28 -to HPS_DDR3_DM[1]
set_location_assignment PIN_V26 -to HPS_DDR3_DM[2]
set_location_assignment PIN_T27 -to HPS_DDR3_DM[3]
# ODT [1:0], Reset, RZQ
set_location_assignment PIN_G26 -to HPS_DDR3_ODT[0]
set_location_assignment PIN_U27 -to HPS_DDR3_ODT[1]
set_location_assignment PIN_T2 -to HPS_DDR3_RESET_n
set_location_assignment PIN_D25 -to HPS_DDR3_RZQ

# HPS Ethernet RGMII (Marvell/Microchip PHY)
# Pins routed through HPS I/O bank — assigned by Platform Designer.
# HPS_ENET_GTX_CLK, HPS_ENET_INT_n, HPS_ENET_MDC, HPS_ENET_MDIO,
# HPS_ENET_RX_CLK, HPS_ENET_RX_DATA[3:0], HPS_ENET_RX_DV,
# HPS_ENET_TX_DATA[3:0], HPS_ENET_TX_EN, HPS_ENET_TX_ER

# HPS SD card
# HPS_SD_CLK, HPS_SD_CMD, HPS_SD_DATA[3:0]

# HPS UART
# HPS_UART_RX, HPS_UART_TX

# HPS USB OTG
# HPS_USB_CLKOUT, HPS_USB_DATA[7:0], HPS_USB_DIR, HPS_USB_NXT, HPS_USB_STP

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name VERILOG_FILE ../src/axi_lite_to_avalon.v
set_global_assignment -name VERILOG_FILE ../src/h2f_axi_to_axilite.v
set_global_assignment -name SDC_FILE ../constraints/miner.sdc
set_global_assignment -name VERILOG_FILE ../src/soc_top.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt_top.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/odocrypt_core.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/odocrypt_epoch_mutator.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/odocrypt_array.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/odocrypt_epoch_tables.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/difficulty_compare.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/perf_counter.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/nonce_scheduler.v
set_global_assignment -name VERILOG_FILE ../src/odocrypt/hash_pll.v
set_global_assignment -name VERILOG_FILE ../src/keccak/keccak800.v
set_global_assignment -name VERILOG_FILE ../src/cdc/cdc_sync.v
set_global_assignment -name VERILOG_FILE ../src/cdc/cdc_found.v
set_global_assignment -name VERILOG_FILE ../src/cdc/cdc_bus.v
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name IP_SEARCH_PATHS "c:/users/builder/documents/github/odo-miner-cyclonev/hdl/qsys"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top