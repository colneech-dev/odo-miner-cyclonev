# =============================================================================
# Quartus Settings File — OdoCrypt Miner for QMTECH Cyclone V SoC
# Device: 5CSXFC6C6U23 (Cyclone V SX, 110K LE, 204 M10K, 112 DSP, 484-ball BGA)
# Board:  QMTECH Cyclone V SoC KFB
# =============================================================================

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6C6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY soc_top
set_global_assignment -name OPTIMIZE_HOLD_TIMING "ALL PATHS"
set_global_assignment -name OPTIMIZE_MULTI_CORNER_TIMING ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# --- Compilation mode ---------------------------------------------------------
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8

# --- Timing constraints -------------------------------------------------------

# --- RTL source files ---------------------------------------------------------

# Top-level SoC wrapper

# Miner Avalon-MM slave

# OdoCrypt core
# odocrypt_compress.v, odocrypt_round.v, odocrypt_sbox_dsp.v are superseded by
# the sequential odocrypt_core.v and archived in hdl/src/odocrypt/archive/

# Keccak-800 post-hash

# Clock-domain crossing

# Qsys-generated system (generated by Platform Designer; not in repo until first build)

# --- HPS/Qsys EDA paths (Quartus needs these for SoC projects) ----------------
set_global_assignment -name HPS_EARLY_IO_RELEASE ON

# --- Synthesis settings -------------------------------------------------------
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name ALLOW_REGISTER_RETIMING ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF

# --- Pipelined miner (feat/pipelined-miner) -----------------------------------
# The pipelined OdoCrypt core needs THROUGHPUT (hash rate fold) and ODOKEY
# (the baked-in epoch seed) as Verilog macros. ODOKEY must match the
# odo_<seed>.v listed in pipelined_miner_hw.tcl and the deployed epoch.
set_global_assignment -name VERILOG_MACRO "THROUGHPUT=8"
set_global_assignment -name VERILOG_MACRO "ODOKEY=1781740800"

# --- Pin assignments ----------------------------------------------------------
# Extracted from QMTECH Cyclone V SoC KFB Schematic v01 (32-bit DDR3)

# 50 MHz board oscillator
set_location_assignment PIN_V11 -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50

# Active-low board reset
set_location_assignment PIN_AE25 -to RESET_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to RESET_n

# HPS DDR3 (32-bit dual-rank: 4 x MT41K256M16, 2 per rank, 2 GB total)
# CRITICAL: ALL DDR3 pin assignments are generated by HPS / Platform Designer.
# DO NOT manually assign DDR3 pin locations here — they conflict with the
# HPS-generated pin Tcl file (hps_sdram_p0_pin_assignments.tcl).
# Source the auto-generated file from soc_system/synthesis/submodules/ instead.
# I/O standards are automatically SSTL15 (1.5V) for DDR3 pins — do NOT override.
#
# To apply HPS DDR3 pin assignments after regenerating soc_system.qsys:
#   source ../qsys/soc_system/synthesis/submodules/hps_sdram_p0_pin_assignments.tcl

# HPS Ethernet RGMII (Marvell/Microchip PHY)
# Pins routed through HPS I/O bank — assigned by Platform Designer.
# HPS_ENET_GTX_CLK, HPS_ENET_INT_n, HPS_ENET_MDC, HPS_ENET_MDIO,
# HPS_ENET_RX_CLK, HPS_ENET_RX_DATA[3:0], HPS_ENET_RX_DV,
# HPS_ENET_TX_DATA[3:0], HPS_ENET_TX_EN, HPS_ENET_TX_ER

# HPS SD card
# HPS_SD_CLK, HPS_SD_CMD, HPS_SD_DATA[3:0]

# HPS UART
# HPS_UART_RX, HPS_UART_TX

# HPS USB OTG
# HPS_USB_CLKOUT, HPS_USB_DATA[7:0], HPS_USB_DIR, HPS_USB_NXT, HPS_USB_STP

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name SDC_FILE ../constraints/miner.sdc
set_global_assignment -name QIP_FILE ../qsys/soc_system/synthesis/soc_system.qip
set_global_assignment -name VERILOG_FILE ../src/soc_top.v
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name IP_SEARCH_PATHS "c:/users/colin/documents/github/odo-miner-cyclonev/hdl/qsys"
set_instance_assignment -name IO_STANDARD "SSTL-15 CLASS I" -to HPS_DDR3_RZQ -tag __hps_sdram_p0
set_instance_assignment -name IO_STANDARD "SSTL-15 CLASS I" -to HPS_DDR3_DQ[0] -tag __hps_sdram_p0
