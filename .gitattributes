*.pof filter=lfs diff=lfs merge=lfs -text
*.img filter=lfs diff=lfs merge=lfs -text
*.rbf filter=lfs diff=lfs merge=lfs -text
*.sof filter=lfs diff=lfs merge=lfs -text

# Keep shell scripts / Makefiles LF so they run on Linux/CI regardless of where
# they were checked out (Windows clones otherwise get CRLF and break /bin/bash).
*.sh     text eol=lf
Makefile text eol=lf
makefile text eol=lf
*.mk     text eol=lf

# Extension-less BusyBox init scripts + sbin helpers MUST stay LF — a CRLF
# checkout (Windows clone w/ autocrlf) makes BusyBox fail them with
# "bad interpreter: ^M" and the board boots to a dead miner/wifi/ssh.
linux/overlay/etc/init.d/* text eol=lf
linux/overlay/usr/sbin/*   text eol=lf

# S11modules parses these with `while read -r module args`, so a CRLF checkout
# would hand modprobe a module name with a trailing ^M and silently load
# nothing — i.e. a board that boots with no WiFi driver and no network.
linux/overlay/etc/modules-load.d/* text eol=lf
